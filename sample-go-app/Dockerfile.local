FROM --platform=linux/arm64 golang:1.25 AS build

WORKDIR /build

# vendor/ is pre-populated on the host by `go mod vendor` (using the local
# replace directive for dd-trace-go) before this image is built.
COPY go.mod go.sum ./
COPY vendor ./vendor
COPY main.go ./

RUN CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -mod=vendor -o /out/server .

FROM --platform=linux/arm64 public.ecr.aws/amazonlinux/amazonlinux:2023

WORKDIR /app

RUN dnf install -y \
    lsof net-tools procps-ng htop iproute iputils \
    vim-enhanced nano wget unzip file \
    && dnf clean all

COPY --from=build /out/server /app/server

COPY serverless-init-linux-arm64 /serverless-init
RUN chmod +x /serverless-init
COPY .dd-env /app/.dd-env
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8080

ENV AWS_LAMBDA_FUNCTION_ARN=arn:aws:lambda:us-east-1:123456789012:microvm:sample-go-app
ENV AWS_LAMBDA_MICROVM_IMAGE_ARN=arn:aws:lambda:us-east-1:123456789012:microvm:sample-go-app
ENV AWS_LAMBDA_FUNCTION_NAME=sample-go-app
ENV DD_SITE=datadoghq.com
ENV DD_SERVICE=sample-go-app
ENV DD_ENV=devmicrovm
ENV DD_VERSION=1
ENV DD_LOGS_ENABLED=true
ENV DD_LOG_LEVEL=debug
ENV DD_TRACE_SAMPLE_RATE=1.0
ENV DD_LOGS_INJECTION=true
ENV DD_TRACE_ENABLED=true
ENV DD_TRACE_AGENT_URL=http://localhost:8126
ENV DD_TRACE_STARTUP_LOGS=true
ENV DD_TRACE_DEBUG=true
ENV DD_SERVERLESS_MICROVM_USER_APP_PORT=8080

ENTRYPOINT ["/entrypoint.sh"]
CMD ["/app/server"]
