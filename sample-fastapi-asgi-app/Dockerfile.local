FROM --platform=linux/arm64 public.ecr.aws/lambda/microvms:al2023-minimal

WORKDIR /app

RUN dnf install -y \
    python3.12 python3.12-pip \
    lsof net-tools procps-ng htop iproute iputils \
    vim-enhanced nano wget unzip file \
    && dnf clean all

COPY requirements.txt .
RUN python3.12 -m pip install --no-cache-dir -r requirements.txt

# Install dd-trace from a pre-built local wheel (linux_aarch64 / cp312).
# The wheel is copied into the build context and its filename is passed via
# --build-arg DD_TRACE_WHEEL by `make build-local`.
ARG DD_TRACE_WHEEL=ddtrace-4.15.0rc2-cp312-cp312-linux_aarch64.whl
COPY ${DD_TRACE_WHEEL} /tmp/
RUN python3.12 -m pip install --target /dd_tracer/python/ --no-cache-dir "/tmp/${DD_TRACE_WHEEL}"

COPY app.py .

COPY serverless-init-linux-arm64 /serverless-init
RUN chmod +x /serverless-init

EXPOSE 8080
EXPOSE 9000
ENV AWS_LAMBDA_MICROVM_IMAGE_ARN=arn:aws:lambda:us-east-1:123456789012:microvm:sample-fastapi-asgi-app
ENV DD_SITE=datadoghq.com
ENV DD_SERVICE=sample-fastapi-asgi-app
ENV DD_SOURCE=python
ENV PYTHONUNBUFFERED=1
ENV DD_VERSION=1
ENV DD_ENV=devmicrovm
ENV DD_LOGS_ENABLED=true
ENV DD_LOG_LEVEL=debug
ENV DD_TRACE_SAMPLE_RATE=1.0
ENV DD_LOGS_INJECTION=true
ENV DD_TRACE_ENABLED=true
ENV DD_TRACE_AGENT_URL=http://localhost:8126
ENV DD_TRACE_STARTUP_LOGS=true
ENV DD_TRACE_DEBUG=true
ENV DD_AWS_MICROVM_USER_APP_PORT=8080

ENTRYPOINT ["/serverless-init"]
CMD ["/dd_tracer/python/bin/ddtrace-run", "python3.12", "app.py"]
