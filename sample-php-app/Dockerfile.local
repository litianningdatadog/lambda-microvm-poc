FROM --platform=linux/arm64 public.ecr.aws/lambda/microvms:al2023-minimal

WORKDIR /app

RUN dnf install -y \
    php \
    php-cli \
    php-json \
    lsof net-tools procps-ng htop iproute iputils \
    vim-enhanced nano wget unzip file curl \
    && dnf clean all

# Install DD PHP tracer (auto-instruments PHP when the extension is loaded)
RUN curl -LO https://github.com/DataDog/dd-trace-php/releases/latest/download/datadog-setup.php \
    && php datadog-setup.php --php-bin=all \
    && rm datadog-setup.php

COPY app.php .

# Old local serverless-init copy path, kept for easy revert:
# COPY serverless-init-linux-arm64 /serverless-init
# RUN chmod +x /serverless-init
COPY --from=datadog/serverless-init:1.10.4 /datadog-init /serverless-init

EXPOSE 8080
EXPOSE 9000

ENV AWS_LAMBDA_MICROVM_IMAGE_ARN=arn:aws:lambda:us-east-1:123456789012:microvm:sample-php-app
ENV DD_SITE=datadoghq.com
ENV DD_SERVICE=sample-php-app
ENV DD_SOURCE=php
ENV DD_VERSION=1
ENV DD_ENV=devmicrovm
ENV DD_LOGS_ENABLED=true
ENV DD_LOG_LEVEL=debug
ENV DD_TRACE_SAMPLE_RATE=1.0
ENV DD_LOGS_INJECTION=true
ENV DD_TRACE_ENABLED=true
ENV DD_TRACE_AGENT_URL=http://localhost:8126
ENV DD_TRACE_STARTUP_LOGS=true
ENV DD_TRACE_DEBUG=true
ENV DD_AWS_MICROVM_USER_APP_PORT=8080

ENTRYPOINT ["/serverless-init"]
CMD ["php", "-S", "0.0.0.0:8080", "/app/app.php"]
